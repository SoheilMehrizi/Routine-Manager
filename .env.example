# Where the app is reachable. DOMAIN is the Caddy site address, PUBLIC_URL the full URL users type.
DOMAIN=life.example.com
PUBLIC_URL=https://life.example.com

# Database
POSTGRES_PASSWORD=change-me

# Google Cloud OAuth client (type: Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# Generate both yourself (see README)
JWT_SECRET=change-me
SECRETS_KEY=change-me

# Optional: restrict which AI hosts users may enter (comma separated), e.g. api.arvancloudai.ir
AI_ALLOWED_HOSTS=
